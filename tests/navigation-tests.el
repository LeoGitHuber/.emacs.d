;;; navigation-tests.el --- Navigation integration checks -*- lexical-binding: t; -*-

(require 'ert)
(require 'init-navigation)

(ert-deftest config-navigation-long-labels-keep-distinguishing-tails ()
  (let ((buffers (mapcar #'generate-new-buffer
                        '("FileTabAccessibilityController.tsx"
                          "项目导航设计笔记-第一版.org"
                          "项目导航设计笔记-第二版.org"
                          "config.json<server>"))))
    (unwind-protect
        (cl-letf (((symbol-function 'frame-width) (lambda (&rest _) 60)))
          (let ((labels (mapcar (lambda (buffer)
                                 (string-trim (my/navigation-file-name buffer buffers)))
                               buffers)))
            (should (= (length (delete-dups (copy-sequence labels))) 4))
            (should (string-suffix-p ".tsx" (car labels)))
            (should (string-suffix-p "第一版.org" (nth 1 labels)))
            (should (string-suffix-p "第二版.org" (nth 2 labels)))
            (dolist (label labels)
              (should (<= (string-width label) 28))))
          (cl-letf (((symbol-function 'window-buffer)
                     (lambda (&rest _) (nth 3 buffers))))
            (should (equal (string-trim (my/navigation-file-name (nth 3 buffers) buffers))
                           "config.json<server>"))))
      (mapc #'kill-buffer buffers))))

(ert-deftest config-navigation-single-row-keeps-current-file-and-workspace ()
  (let ((buffers (cl-loop for n below 12
                          collect (generate-new-buffer
                                   (format "navigation-component-%02d.el" n)))))
    (unwind-protect
        (save-window-excursion
          (switch-to-buffer (nth 8 buffers))
          (cl-letf (((symbol-function 'tab-line-tabs-fixed-window-buffers)
                     (lambda () buffers)))
            (dolist (width '(40 60 100 150))
              (cl-letf (((symbol-function 'frame-width) (lambda (&rest _) width))
                        ((symbol-function 'frame-inner-width) (lambda (&rest _) width)))
                (let* ((items (my/tab-bar-format-files))
                       (workspace (my/tab-bar-format-workspace))
                       (labels (mapcar (lambda (item) (nth 2 item)) items)))
                  (should (assq 'files-overflow items))
                  (should (assq 'file-close items))
                  (should (seq-some
                           (lambda (label)
                             (and (eq (get-text-property 0 'face label)
                                      'tab-line-tab-current)
                                  (string-match-p "08.el" label)))
                           labels))
                  (should (<= (+ (string-width (apply #'concat labels))
                                 (string-width (nth 2 (car workspace))))
                              width)))))))
      (mapc #'kill-buffer buffers)))
  (should-not global-tab-line-mode)
  (should (equal tab-bar-format
                 '(my/tab-bar-format-files tab-bar-format-align-right
                   my/tab-bar-format-workspace))))

(ert-deftest config-navigation-workspace-menu-selects-by-full-name ()
  (let ((name "workspace-with-a-name-longer-than-the-label")
        menu selected)
    (cl-letf (((symbol-function 'tab-bar-tabs)
               (lambda (&rest _) `((current-tab (name . "Default"))
                                   (tab (name . ,name)))))
              ((symbol-function 'popup-menu) (lambda (items &rest _) (setq menu items)))
              ((symbol-function 'tab-bar-select-tab-by-name)
               (lambda (name) (setq selected name))))
      (my/navigation-workspace-menu)
      (should (equal (aref (nth 2 menu) 0) name))
      (should (eq (aref (nth 1 menu) 5) t))
      (call-interactively (aref (nth 2 menu) 1))
      (should (equal selected name)))))

(ert-deftest config-navigation-keys-switch-files-not-workspaces ()
  (require 'hideshow)
  (with-temp-buffer
    (emacs-lisp-mode)
    (hs-minor-mode 1)
    (should (eq (key-binding (kbd "C-<tab>")) #'tab-line-switch-to-next-tab))
    (should (eq (key-binding (kbd "C-S-<tab>")) #'tab-line-switch-to-prev-tab))
    (should (eq (key-binding (kbd "C-c <left>")) #'tab-bar-history-back))))

(ert-deftest config-navigation-projects-windows-and-file-tabs ()
  "Exercise two workspaces, split editors, a popup and a foreign reference."
  (let* ((sandbox (make-temp-file "emacs-navigation-" t))
         (root-a (file-name-as-directory (expand-file-name "project-a" sandbox)))
         (root-b (file-name-as-directory (expand-file-name "project-b" sandbox)))
         (saved-tabs (copy-tree (frame-parameter nil 'tabs)))
         (saved-buffers (frame-parameter nil 'buffer-list))
         (saved-buried (frame-parameter nil 'buried-buffer-list))
         (saved-editor (frame-parameter nil 'my/editor-window))
         (original-buffers (buffer-list))
         (original-processes (process-list))
         (project-list-file (expand-file-name "projects" sandbox))
         (project--list nil)
         (tabspaces-project-tab-map nil)
         (dirvish--sessions (make-hash-table :test #'equal))
         (super-save-mode nil)
         (tab-bar-history-mode nil)
         left right sidebar popup a1 a2 b1)
    (make-directory root-a)
    (make-directory root-b)
    (dolist (file (list (concat root-a "one.txt") (concat root-a "two.txt")
                        (concat root-a "three.txt") (concat root-b "other.txt")))
      (write-region "navigation fixture\n" nil file nil 'silent))
    (unwind-protect
        (save-window-excursion
          (my/project-workspace root-a)
          (should (equal (my/workspace-root) root-a))
          (setq sidebar (dirvish-side--session-visible-p)
                left (selected-window)
                a1 (find-file (concat root-a "one.txt")))
          (should (window-live-p sidebar))
          (setq right (split-window-right))
          (select-window right)
          (setq a2 (find-file (concat root-a "two.txt")))
          (my/remember-editor-window)
          (should (eq (my/navigation-editor-window) right))
          ;; A later popup selection must not become the file's destination.
          (setq popup (display-buffer-in-side-window
                       (get-buffer-create "*Navigation output*")
                       '((side . bottom) (window-height . 0.2))))
          (select-window popup)
          (should (eq (my/navigation-editor-window) right))
          (select-window sidebar)
          (should (eq (my/navigation-editor-window) right))
          ;; A file tab uses the captured editor even while the tree has focus.
          (let ((item (seq-find
                       (lambda (item)
                         (equal (plist-get (nthcdr 4 item) :help)
                                (buffer-file-name a1)))
                       (my/tab-bar-format-files))))
            (should item)
            (call-interactively (nth 3 item))
            (should (eq (selected-window) right))
            (should (eq (window-buffer right) a1)))
          (select-window sidebar)
          (should-not mouse-1-click-follows-link)
          (should (eq (key-binding [mouse-1]) #'dirvish-subtree-toggle-or-open))
          (should (eq (key-binding [mouse-2]) #'dirvish-subtree-toggle-or-open))
          (should (dired-goto-file (expand-file-name "three.txt" default-directory)))
          (dired-find-file)
          (should (eq (selected-window) right))
          (should (file-equal-p (buffer-file-name (window-buffer right))
                         (concat root-a "three.txt")))
          (should (eq (window-buffer left) a1))
          (should (equal (buffer-name (window-buffer popup)) "*Navigation output*"))
          ;; Switching files preserves the visible tab order.
          (let ((order (tab-line-tabs-fixed-window-buffers)))
            (switch-to-buffer a2)
            (should (equal (tab-line-tabs-fixed-window-buffers) order)))
          (my/project-workspace root-b)
          (setq b1 (find-file (concat root-b "other.txt")))
          (should (equal (my/workspace-file-buffers) (list b1)))
          (should (equal (funcall consult-buffer-list-function) (list b1)))
          (should (equal (tab-line-tabs-fixed-window-buffers) (list b1)))
          (should (equal (my/workspace-root) root-b))
          (my/project-workspace root-a)
          (should (eq (window-buffer left) a1))
          (should (eq (window-buffer right) a2))
          (should-not (memq b1 (my/workspace-file-buffers)))
          (should-not (memq (get-buffer "*Navigation output*")
                            (my/workspace-file-buffers)))
          ;; An explicitly opened outside file joins A without moving A's tree.
          (select-window right)
          (switch-to-buffer b1)
          (my/dirvish-follow-file)
          (should (equal (my/workspace-root) root-a))
          (should (memq b1 (my/workspace-file-buffers)))
          (should (file-equal-p (buffer-local-value 'default-directory
                                             (window-buffer sidebar)) root-a))
          (cl-letf (((symbol-function 'project-find-file)
                     (lambda () (interactive)
                       (should (equal default-directory root-a)))))
            (my/project-find-file))
          ;; Plain folder navigation must not create repository or TODO files.
          (dolist (root (list root-a root-b))
            (dolist (name '(".git" ".project" "project-todo.org"))
              (should-not (file-exists-p (expand-file-name name root))))))
      (set-frame-parameter nil 'tabs saved-tabs)
      (set-frame-parameter nil 'buffer-list saved-buffers)
      (set-frame-parameter nil 'buried-buffer-list saved-buried)
      (set-frame-parameter nil 'my/editor-window saved-editor)
      (dolist (process (seq-difference (process-list) original-processes))
        (set-process-sentinel process #'ignore)
        (delete-process process))
      (dolist (buffer (seq-difference (buffer-list) original-buffers))
        (when (buffer-live-p buffer)
          (with-current-buffer buffer (set-buffer-modified-p nil))
          (kill-buffer buffer)))
      ;; Windows may retain a directory handle until async children exit.
      ;; Keep the tiny temp fixture available for diagnosing failed GUI runs.
      nil)))

